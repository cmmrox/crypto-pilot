# Development reverse proxy. In production, replace :80 with your domain for auto-TLS.
:80 {
	encode gzip

	# API and health → backend
	handle /health {
		reverse_proxy backend:8000
	}
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /ws/* {
		reverse_proxy backend:8000
	}

	# Everything else → frontend SPA
	handle {
		reverse_proxy frontend:80
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
