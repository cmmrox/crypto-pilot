secrets/
credentials.json
auth.json
service-account*.json

# Codex / OpenAI / auth session stores (device-code tokens live here)
.openai/
.codex/
**/codex/
**/.codex/

# Databases, dumps & encrypted backups — never commit
*.sqlite
*.sqlite3
*.db
*.sql.gz
*.dump
*.bak
*.enc
cp-*.sql.gz.enc

