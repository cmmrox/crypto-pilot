# Development reverse proxy. In production, replace :80 with your domain for auto-TLS.
:80 {
	encode gzip

	# API and health → backend
	handle /health* {
		reverse_proxy backend:8000
	}
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /ws/* {
		reverse_proxy backend:8000
	}

	# Everything else → frontend SPA
	handle {
		reverse_proxy frontend:80
	}

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ws: wss:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
