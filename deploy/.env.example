# CryptoPilot environment — copy to deploy/.env and fill in. NEVER commit deploy/.env.
# Generate MASTER_KEY and CP_JWT_SECRET with: openssl rand -base64 32

# --- Postgres ---
# The app reuses an EXISTING shared Postgres server rather than running its own.
# Create a dedicated cryptopilot role + database inside it, then set these.
POSTGRES_USER=cryptopilot
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=cryptopilot
# CP_DB_NETWORK: docker network the shared Postgres is attached to.
# CP_DB_HOST:    that Postgres's network alias/hostname on that network.
CP_DB_NETWORK=gen-one-network
CP_DB_HOST=genone-postgres

# --- Backend ---
CP_ENVIRONMENT=development
CP_DATABASE_URL=postgresql+asyncpg://cryptopilot:change-me-strong@genone-postgres:5432/cryptopilot
CP_MASTER_KEY=REPLACE_WITH_openssl_rand_base64_32
CP_JWT_SECRET=REPLACE_WITH_openssl_rand_base64_32
CP_FRONTEND_ORIGIN=http://localhost:8080
CP_LOG_LEVEL=INFO
CP_LOG_JSON=true
# E2E only: both require CP_ENVIRONMENT=test and must remain false in production.
CP_OTP_TEST_MODE=false
CP_OTP_TEST_DISABLE_THROTTLE=false

# Stage 12 only. Keep both false until the four-week DEMO soak, owner sign-off,
# and independent Binance key-permission/IP-allowlist verification are complete.
CP_LIVE_TRADING_APPROVED=false
CP_LIVE_KEY_PERMISSIONS_VERIFIED=false

# --- Binance (Stage 2+, DEMO first) ---
# Stored via the Settings UI (encrypted); these are only for local scripts if needed.
# CP_BINANCE_DEMO_KEY=
# CP_BINANCE_DEMO_SECRET=

# --- notify.lk (Stage 7) ---
# Stored via the Settings UI (encrypted).

# --- Codex SDK / GPT-5.5 (Stage 8) ---
# CODEX_API_KEY=

# --- Production (docker-compose.prod.yml) ---
CP_DOMAIN=pilot.yourdomain.com
CP_BACKUP_BUCKET=          # Required in production: s3://bucket/path; AWS creds via env
CP_BACKUP_DIR=./backups    # Local encrypted copies; use an absolute host path on VPS
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, optional AWS_SESSION_TOKEN,
# AWS_DEFAULT_REGION, and AWS_ENDPOINT_URL are passed from the deployment shell.
