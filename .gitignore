.artifacts/
tmp/
output/
.lab-data/
var/experiment-lab/

# TypeScript incremental build cache
*.tsbuildinfo

# Strategy research results and findings — kept local, never published.
# The strategy code is public; anyone using it must run their own backtests.
private/
research/results/
experiments/monthly_income_research/results/
experiments/backtesting/results/
experiments/experiment_lab/src/experiment_lab/research/*.md
docs/reports/
docs/design/*.png
docs/BUSINESS_SOLUTION_v2.pdf
docs/archive/BUSINESS_SOLUTION.pdf
docs/tools/make_bsd.py
tradingview/ATLAS_6_AND_52_QA.md
# QA reports are private by default: research, release and audit reports carry
# backtest figures. Only stage-gate and incident reports are published; publish
# any other report deliberately with `git add -f` after checking it has no results.
docs/qa/reports/*
!docs/qa/reports/STAGE-*.md
!docs/qa/reports/INCIDENT-*.md
docs/qa/reports/STAGE-03-REPORT.md
